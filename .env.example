# Copy to .env and fill values for your environment / client SMTP.

POSTGRES_DB=training_platform
POSTGRES_USER=training_user
POSTGRES_PASSWORD=training_password
POSTGRES_PORT=5432

BACKEND_PORT=8080
FRONTEND_PORT=4200
ML_PORT=8000

JWT_SECRET=change-this-secret-key-to-at-least-32-characters
JWT_EXPIRATION_MS=86400000

APP_ML_ENABLED=true

# Client SMTP (update when client provides credentials)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=ramzii.jomaa@gmail.com
MAIL_PASSWORD=
MAIL_FROM=ramzii.jomaa@gmail.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

APP_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost,http://localhost:80

# DevOps UI ports (docker-compose.devops.yml)
JENKINS_PORT=8081
SONAR_PORT=9000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Jenkins ↔ GitHub (set after you create the repo)
GITHUB_REPO_URL=
GITHUB_BRANCH=main
GITHUB_CREDENTIALS_ID=github-credentials
